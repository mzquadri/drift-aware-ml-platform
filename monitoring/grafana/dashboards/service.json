{
  "title": "Demand service",
  "uid": "demand-service",
  "tags": ["ml", "serving"],
  "timezone": "browser",
  "refresh": "30s",
  "time": { "from": "now-6h", "to": "now" },
  "panels": [
    {
      "type": "stat",
      "title": "Model loaded",
      "description": "0 means the service is live but has no champion, so /ready is failing and traffic should not be routed here.",
      "gridPos": { "h": 4, "w": 6, "x": 0, "y": 0 },
      "targets": [{ "expr": "model_ready", "refId": "A" }],
      "fieldConfig": {
        "defaults": {
          "mappings": [
            { "type": "value", "options": { "0": { "text": "no model", "color": "red" }, "1": { "text": "ready", "color": "green" } } }
          ]
        }
      }
    },
    {
      "type": "stat",
      "title": "Predictions per second",
      "gridPos": { "h": 4, "w": 6, "x": 6, "y": 0 },
      "targets": [{ "expr": "sum(rate(predictions_total{outcome=\"ok\"}[5m]))", "refId": "A" }]
    },
    {
      "type": "stat",
      "title": "Error share (5m)",
      "description": "Anything above zero here means requests are being refused, either because no model is loaded or because prediction threw.",
      "gridPos": { "h": 4, "w": 6, "x": 12, "y": 0 },
      "targets": [
        { "expr": "sum(rate(predictions_total{outcome!=\"ok\"}[5m])) / clamp_min(sum(rate(predictions_total[5m])), 0.001)", "refId": "A" }
      ],
      "fieldConfig": { "defaults": { "unit": "percentunit" } }
    },
    {
      "type": "stat",
      "title": "p95 latency",
      "gridPos": { "h": 4, "w": 6, "x": 18, "y": 0 },
      "targets": [
        { "expr": "histogram_quantile(0.95, sum(rate(prediction_latency_seconds_bucket[5m])) by (le))", "refId": "A" }
      ],
      "fieldConfig": { "defaults": { "unit": "s" } }
    },
    {
      "type": "timeseries",
      "title": "Latency percentiles",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 4 },
      "targets": [
        { "expr": "histogram_quantile(0.50, sum(rate(prediction_latency_seconds_bucket[5m])) by (le))", "legendFormat": "p50", "refId": "A" },
        { "expr": "histogram_quantile(0.95, sum(rate(prediction_latency_seconds_bucket[5m])) by (le))", "legendFormat": "p95", "refId": "B" },
        { "expr": "histogram_quantile(0.99, sum(rate(prediction_latency_seconds_bucket[5m])) by (le))", "legendFormat": "p99", "refId": "C" }
      ],
      "fieldConfig": { "defaults": { "unit": "s" } }
    },
    {
      "type": "timeseries",
      "title": "Predicted demand distribution",
      "description": "The shape of what the model is predicting. A sudden shift here is usually the first visible sign of drift, well before anyone reads a report.",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 4 },
      "targets": [
        { "expr": "histogram_quantile(0.10, sum(rate(predicted_demand_bucket[15m])) by (le))", "legendFormat": "p10", "refId": "A" },
        { "expr": "histogram_quantile(0.50, sum(rate(predicted_demand_bucket[15m])) by (le))", "legendFormat": "median", "refId": "B" },
        { "expr": "histogram_quantile(0.90, sum(rate(predicted_demand_bucket[15m])) by (le))", "legendFormat": "p90", "refId": "C" }
      ]
    },
    {
      "type": "timeseries",
      "title": "Requests by outcome",
      "gridPos": { "h": 8, "w": 24, "x": 0, "y": 12 },
      "targets": [
        { "expr": "sum by (outcome) (rate(predictions_total[5m]))", "legendFormat": "{{outcome}}", "refId": "A" }
      ]
    }
  ],
  "schemaVersion": 39,
  "version": 1
}
